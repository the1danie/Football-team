# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF
# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=111111111,222222222
# PostgreSQL в проде; для локального запуска можно sqlite+aiosqlite:///football.db
DATABASE_URL=postgresql+asyncpg://football:football@db:5432/football
# Чат команды (необязательно — проще выполнить /bindchat в самом чате)
GROUP_CHAT_ID=
# Часовой пояс команды
TZ_NAME=Asia/Almaty
# За сколько часов до начала автоматически распределять обязанности (0 — только вручную)
AUTO_DISTRIBUTE_HOURS=5
# Личное напоминание ответственным, часов до начала
PERSONAL_REMINDER_HOURS=3
# Напоминание в общий чат, часов до начала
GROUP_REMINDER_HOURS=2

# --- Опрос «кто придёт» и минусы ---
# Напомнить не ответившим за столько часов до закрытия сбора
RSVP_REMINDER_HOURS=3
# Сколько минусов за неответ (0 — не начислять)
PENALTY_POINTS=1
# С какого количества минусов предупреждать админов и игрока
PENALTY_LIMIT=3
# Насколько минус поднимает игрока в очереди на обязанности
PENALTY_PRIORITY=10
# Писать в общий чат, кто получил минус (0 — только лично)
PENALTY_ANNOUNCE=1

# --- Только для Vercel (режим webhook) ---
# Случайная строка (openssl rand -hex 32) — пароль для /api/tick и /api/health
CRON_SECRET=
# Необязательно: по умолчанию выводится из BOT_TOKEN
WEBHOOK_SECRET=
# Необязательно: адрес проекта, если /api/setup открываете не с него
PUBLIC_URL=
