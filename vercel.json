{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/*.py": {
      "maxDuration": 60,
      "includeFiles": "bot/**"
    }
  },
  "crons": [
    {
      "path": "/api/tick",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/app"
    },
    {
      "source": "/app",
      "destination": "/api/app"
    }
  ]
}
